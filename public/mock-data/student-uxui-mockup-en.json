    }
  ],
  "rubrics": [
    {
      "id": "r-mock-10",
      "assignmentId": "a-mock-10",
      "name": "UX/UI Final Project rubric",
      "criteria": [
        {
          "id": "rc-uxui-1",
          "name": "C1 · Screen Completeness & Content Realism",
          "description": "How complete the screens' elements are and how realistic the content is",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "Excellent",
              "description": "All elements required by the screens and the assigned tasks are present, and the content is realistic, relying little on Lorem Ipsum or stand-in data."
            },
            {
              "label": "Fair",
              "description": "Most elements are present; some details or content are still incomplete."
            },
            {
              "label": "Needs Improvement",
              "description": "Several important elements are missing, or obvious placeholder content remains."
            },
            {
              "label": "Fail",
              "description": "Many important elements are missing, so the screens are incomplete or cannot convey how the product is used."
            }
          ]
        },
        {
          "id": "rc-uxui-2",
          "name": "C2 · Layout & Balance",
          "description": "How balanced the screen layout is",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "Excellent",
              "description": "The layout is balanced and uses space appropriately for the content and the screen's purpose, with no empty areas or density that get in the way of use."
            },
            {
              "label": "Fair",
              "description": "Generally balanced, but a few areas are slightly too crowded or too empty."
            },
            {
              "label": "Needs Improvement",
              "description": "Balance problems in several areas make some reading or use inconvenient."
            },
            {
              "label": "Fail",
              "description": "The layout is clearly unbalanced and hurts understanding or use."
            }
          ]
        },
        {
          "id": "rc-uxui-3",
          "name": "C3 · Spacing, Alignment & Grid Pattern",
          "description": "Consistency of spacing, alignment and grid",
          "maxPoints": 10,
          "weight": 10,
          "levels": [
            {
              "label": "Excellent",
              "description": "Spacing, alignment and grid follow a clear, consistent pattern, and elements sit on systematic lines."
            },
            {
              "label": "Fair",
              "description": "Generally consistent, with small deviations in a few places."
            },
            {
              "label": "Needs Improvement",
              "description": "Spacing or alignment is inconsistent in several places, and the UI starts to look unsystematic."
            },
            {
              "label": "Fail",
              "description": "There is no clear spacing/alignment pattern, and the UI looks unsystematic."
            }
          ]
        },
        {
          "id": "rc-uxui-4",
          "name": "C4 · Component Consistency & Design System",
          "description": "Consistent use of components, styles and a design system",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "Excellent",
              "description": "Color styles, typography styles and components/variants are used systematically; elements with the same function look the same on every screen."
            },
            {
              "label": "Fair",
              "description": "Generally consistent, with minor differences in some elements or some parts that do not use a style/component."
            },
            {
              "label": "Needs Improvement",
              "description": "Components, colors or typography differ in several places without a clear reason."
            },
            {
              "label": "Fail",
              "description": "Each screen looks clearly different; there is no design system or shared pattern."
            }
          ]
        },
        {
          "id": "rc-uxui-5",
          "name": "C5 · Visual Hierarchy",
          "description": "How clearly the screen shows what matters most",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "Excellent",
              "description": "Primary and secondary information and the primary action are clearly distinguishable; size, color, weight and position guide the eye appropriately."
            },
            {
              "label": "Fair",
              "description": "The hierarchy is clear overall, but some parts do not distinguish importance well."
            },
            {
              "label": "Needs Improvement",
              "description": "Several parts have similar visual weight, so users cannot tell what to look at or do first."
            },
            {
              "label": "Fail",
              "description": "There is no clear hierarchy, which makes the screen hard to understand."
            }
          ]
        },
        {
          "id": "rc-uxui-6",
          "name": "C6 · Typography, Color & Accessibility",
          "description": "Readable type, consistent color, sufficient contrast",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "Excellent",
              "description": "Text is easy to read with suitable size and weight, colors are consistent, contrast is sufficient, and color is not the only way meaning is conveyed."
            },
            {
              "label": "Fair",
              "description": "Generally readable and accessible, with minor problems such as text size or contrast in places."
            },
            {
              "label": "Needs Improvement",
              "description": "Several reading or accessibility problems, such as small text, low contrast, or colors that convey meaning unclearly."
            },
            {
              "label": "Fail",
              "description": "Severe typography/color/contrast problems that hurt reading or use."
            }
          ]
        },
        {
          "id": "rc-uxui-7",
          "name": "C7 · Prototype Flow & Interaction Completeness",
          "description": "Whether the prototype's core flow works end to end",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "Excellent",
              "description": "The core user flow works from start to finish with no dead ends, and the necessary interactions are linked correctly."
            },
            {
              "label": "Fair",
              "description": "The core flow almost fully works, with small issues such as a link or transition in places."
            },
            {
              "label": "Needs Improvement",
              "description": "Several flow problems, such as wrong links, missing connections or dead ends."
            },
            {
              "label": "Fail",
              "description": "The core user flow cannot be completed, or the prototype lacks necessary connections."
            }
          ]
        }
      ],
      "createdAt": "2026-08-12T09:00:00.000Z",
      "updatedAt": "2026-08-12T09:00:00.000Z"
    }
  ],

      "id": "a-mock-10",
      "courseId": "c-mock-4",
      "name": "UX/UI Final Project",
      "description": "Design and build a Figma prototype of an app of your choice with a complete core user flow and a design system (color/typography styles and components), then hand in the Figma and prototype links.",
      "dueDate": "2026-10-05",
      "maxPoints": 100,
      "categoryId": "gcat-seed-c4-1",
      "acceptsFiles": true,
      "fileTypes": [
        "figma",
        "pdf"
      ],
      "submissionType": "individual",
      "maxGroupSize": null,
      "rubricIds": [
        "r-mock-10"
      ],
      "gradingFinalized": true,
      "createdAt": "2026-08-12T09:00:00.000Z",
